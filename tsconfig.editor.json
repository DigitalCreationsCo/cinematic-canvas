{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "noEmit": true,
        "composite": false,
        "baseUrl": ".",
        "paths": {
            "#client/mocks/*": ["./src/client/mocks/*"],
            "#client/*": ["./src/client/src/*"],
            "#shared/*": ["./src/shared/*"],
            "#worker/*": ["./src/worker/*"],
            "#pipeline/*": ["./src/pipeline/*"],
            "#server/*": ["./src/server/*"],
            "#*": ["./src/*"]
        },
        "types": ["node"]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.js",
        "src/**/*.jsx"
    ],
    "exclude": [
        "**/node_modules",
        "**/dist",
        "**/.next",
        "**/*.test.*",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/coverage"
    ]
}
