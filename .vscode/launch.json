{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Current File",
            "type": "node",
            "request": "launch",
            "program": "${file}",
            "runtimeArgs": [
                "--import",
                "tsx"
            ],
            "args": [
                "${file}"
            ],
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "sourceMaps": true,
            "internalConsoleOptions": "neverOpen"
        },
        {
            "name": "Launch Worker",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/dev-runner.ts",
            "runtimeArgs": [
                "--max-old-space-size=512"
            ],
            "args": [
                "${workspaceFolder}/src/worker/index.ts"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "console": "integratedTerminal",
            "restart": true,
            "autoAttachChildProcesses": true,
            "sourceMaps": true
        },
        {
            "name": "Launch Pipeline",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/dev-runner.ts",
            "runtimeArgs": [
                "--max-old-space-size=512"
            ],
            "args": [
                "${workspaceFolder}/src/pipeline/index.ts"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "console": "integratedTerminal",
            "restart": true,
            "autoAttachChildProcesses": true,
            "sourceMaps": true
        },
        {
            "name": "Launch Server",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/dev-runner.ts",
            "runtimeArgs": [
                "--max-old-space-size=512"
            ],
            "args": [
                "${workspaceFolder}/src/server/index.ts"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "console": "integratedTerminal",
            "restart": true,
            "autoAttachChildProcesses": true,
            "sourceMaps": true
        },
        {
            "name": "🚀 Launch Monolith",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/dev-runner.ts",
            "runtimeArgs": [
                "--max-old-space-size=2048"
            ],
            "args": [
                "${workspaceFolder}/src/monolith.ts"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "console": "integratedTerminal",
            "restart": true,
            "autoAttachChildProcesses": true,
            "sourceMaps": true
        },
        {
            "name": "Debug Client",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:8000",
            "webRoot": "${workspaceFolder}/src/client",
            "sourceMapPathOverrides": {
                "webpack:///./src/*": "${webRoot}/*",
                "vsmaps:///*": "${workspaceFolder}/*"
            }
        },
        {
            "name": "Debug Build (server)",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/dist/server/index.js",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ],
            "resolveSourceMapLocations": [
                "${workspaceFolder}/src/**",
                "${workspaceFolder}/dist/**",
                "!**/node_modules/**"
            ],
            "restart": true,
            "autoAttachChildProcesses": true,
            "smartStep": true,
        },
        {
            "name": "Debug Build (worker)",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/dist/worker/index.js",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ],
            "resolveSourceMapLocations": [
                "${workspaceFolder}/src/**",
                "${workspaceFolder}/dist/**",
                "!**/node_modules/**"
            ],
            "restart": true,
            "autoAttachChildProcesses": true,
            "smartStep": true
        },
        {
            "name": "Debug Build (pipeline)",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/dist/pipeline/index.js",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ],
            "resolveSourceMapLocations": [
                "${workspaceFolder}/src/**",
                "${workspaceFolder}/dist/**",
                "!**/node_modules/**"
            ],
            "restart": true,
            "autoAttachChildProcesses": true,
            "smartStep": true
        },
        {
            "name": "Attach Worker",
            "type": "node",
            "request": "attach",
            "port": 9231,
            "restart": true,
            "address": "localhost",
            "localRoot": "${workspaceFolder}",
            "remoteRoot": "/app",
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ],
            "resolveSourceMapLocations": [
                "${workspaceFolder}/src/**",
                "${workspaceFolder}/dist/**",
                "!**/node_modules/**"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "Attach Pipeline",
            "type": "node",
            "request": "attach",
            "port": 9230,
            "restart": true,
            "address": "localhost",
            "localRoot": "${workspaceFolder}",
            "remoteRoot": "/app",
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ],
            "resolveSourceMapLocations": [
                "${workspaceFolder}/src/**",
                "${workspaceFolder}/dist/**",
                "!**/node_modules/**"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "Attach Server",
            "type": "node",
            "request": "attach",
            "port": 9229,
            "restart": true,
            "address": "localhost",
            "localRoot": "${workspaceFolder}",
            "remoteRoot": "/app",
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ],
            "resolveSourceMapLocations": [
                "${workspaceFolder}/src/**",
                "${workspaceFolder}/dist/**",
                "!**/node_modules/**"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "Launch Workflow - Debug Existing Video",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/dist/pipeline/execute-workflow.js",
            "args": [
                "--id",
                "video_1765360860268"
            ],
            "preLaunchTask": "npx tsc -b",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "sourceMaps": true,
            "smartStep": true,
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ],
            "resolveSourceMapLocations": [
                "${workspaceFolder}/src/**",
                "${workspaceFolder}/dist/**",
                "!**/node_modules/**"
            ],
            "internalConsoleOptions": "openOnSessionStart"
        }
    ],
    "compounds": [
        {
            "name": "Launch Microservices (dev)",
            "configurations": [
                "Launch Worker",
                "Launch Pipeline",
                "Launch Server",
            ],
            "preLaunchTask": "Watch All (dev)"
        },
        {
            "name": "Launch Monolith (dev)",
            "configurations": [
                "🚀 Launch Monolith"
            ],
            "preLaunchTask": "Watch All (dev)"
        },
        {
            "name": "Attach All",
            "configurations": [
                "Attach Server",
                "Attach Pipeline",
                "Attach Worker"
            ]
        },
        {
            "name": "Launch Microservices (build)",
            "configurations": [
                "Debug Build (server)",
                "Debug Build (worker)",
                "Debug Build (pipeline)"
            ],
            "preLaunchTask": "Build Project"
        }
    ]
}