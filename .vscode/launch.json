{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Backend",
            "type": "debugpy",
            "request": "launch",
            "env": {
                "PX_DEV": "narrative"
            },
            "module": "uvicorn",
            "args": [
                "--factory",
                "portals.main:create_app",
                "--host",
                "127.0.0.1",
                "--port",
                "7860",
                "--reload",
                "--env-file",
                ".env",
                "--loop",
                "asyncio"
            ],
            "jinja": true,
            "python": "${workspaceFolder}/.venv/bin/python",
            "subProcess": true // Attach to the worker subprocesses
        },
        {
            "name": "Debug Frontend",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm start",
            "cwd": "${workspaceFolder}/src/frontend",
            "preLaunchTask": "kill-port-3000"
        },
        {
            "name": "Debug Current File (node)",
            "type": "node",
            "request": "launch",
            "program": "${file}",
            "runtimeArgs": [
                "--import",
                "tsx"
            ],
            "args": [
                "${file}"
            ],
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "sourceMaps": true,
            "internalConsoleOptions": "neverOpen"
        },
        {
            "name": "Launch Legacy Worker",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/dev-runner.ts",
            "runtimeArgs": [
                "--max-old-space-size=512"
            ],
            "args": [
                "${workspaceFolder}/src/worker/index.ts"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "console": "integratedTerminal",
            "restart": true,
            "autoAttachChildProcesses": true,
            "sourceMaps": true
        },
        {
            "name": "Launch Legacy Pipeline",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/dev-runner.ts",
            "runtimeArgs": [
                "--max-old-space-size=512"
            ],
            "args": [
                "${workspaceFolder}/src/pipeline/index.ts"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "console": "integratedTerminal",
            "restart": true,
            "autoAttachChildProcesses": true,
            "sourceMaps": true
        },
        {
            "name": "Launch Legacy Server",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/dev-runner.ts",
            "runtimeArgs": [
                "--max-old-space-size=512"
            ],
            "args": [
                "${workspaceFolder}/src/server/index.ts"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "console": "integratedTerminal",
            "restart": true,
            "autoAttachChildProcesses": true,
            "sourceMaps": true
        },
        {
            "name": "🚀 Launch Legacy Monolith",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/dev-runner.ts",
            "runtimeArgs": [
                "--max-old-space-size=2048"
            ],
            "args": [
                "${workspaceFolder}/src/monolith.ts"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "console": "integratedTerminal",
            "restart": true,
            "autoAttachChildProcesses": true,
            "sourceMaps": true
        },
        {
            "name": "Debug Legacy Client",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:8000",
            "webRoot": "${workspaceFolder}/src/client",
            "sourceMapPathOverrides": {
                "webpack:///./src/*": "${webRoot}/*",
                "vsmaps:///*": "${workspaceFolder}/*"
            }
        },
        {
            "name": "Debug Legacy Build (server)",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/dist/server/index.js",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ],
            "resolveSourceMapLocations": [
                "${workspaceFolder}/src/**",
                "${workspaceFolder}/dist/**",
                "!**/node_modules/**"
            ],
            "restart": true,
            "autoAttachChildProcesses": true,
            "smartStep": true,
        },
        {
            "name": "Debug Legacy Build (worker)",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/dist/worker/index.js",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ],
            "resolveSourceMapLocations": [
                "${workspaceFolder}/src/**",
                "${workspaceFolder}/dist/**",
                "!**/node_modules/**"
            ],
            "restart": true,
            "autoAttachChildProcesses": true,
            "smartStep": true
        },
        {
            "name": "Debug Legacy Build (pipeline)",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/dist/pipeline/index.js",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ],
            "resolveSourceMapLocations": [
                "${workspaceFolder}/src/**",
                "${workspaceFolder}/dist/**",
                "!**/node_modules/**"
            ],
            "restart": true,
            "autoAttachChildProcesses": true,
            "smartStep": true
        },
        {
            "name": "Attach Legacy Worker",
            "type": "node",
            "request": "attach",
            "port": 9231,
            "restart": true,
            "address": "localhost",
            "localRoot": "${workspaceFolder}",
            "remoteRoot": "/app",
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ],
            "resolveSourceMapLocations": [
                "${workspaceFolder}/src/**",
                "${workspaceFolder}/dist/**",
                "!**/node_modules/**"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "Attach Legacy Pipeline",
            "type": "node",
            "request": "attach",
            "port": 9230,
            "restart": true,
            "address": "localhost",
            "localRoot": "${workspaceFolder}",
            "remoteRoot": "/app",
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ],
            "resolveSourceMapLocations": [
                "${workspaceFolder}/src/**",
                "${workspaceFolder}/dist/**",
                "!**/node_modules/**"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "Attach Legacy Server",
            "type": "node",
            "request": "attach",
            "port": 9229,
            "restart": true,
            "address": "localhost",
            "localRoot": "${workspaceFolder}",
            "remoteRoot": "/app",
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ],
            "resolveSourceMapLocations": [
                "${workspaceFolder}/src/**",
                "${workspaceFolder}/dist/**",
                "!**/node_modules/**"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "Launch Legacy Workflow - Debug Existing Video",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/dist/pipeline/execute-workflow.js",
            "args": [
                "--id",
                "video_1765360860268"
            ],
            "preLaunchTask": "npx tsc -b",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "sourceMaps": true,
            "smartStep": true,
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ],
            "resolveSourceMapLocations": [
                "${workspaceFolder}/src/**",
                "${workspaceFolder}/dist/**",
                "!**/node_modules/**"
            ],
            "internalConsoleOptions": "openOnSessionStart"
        }
    ],
    "compounds": [
        {
            "name": "Launch Legacy Microservices (dev)",
            "configurations": [
                "Launch Legacy Worker",
                "Launch Legacy Pipeline",
                "Launch Legacy Server",
            ],
            "preLaunchTask": "Watch All (dev)"
        },
        {
            "name": "Launch Legacy Monolith (dev)",
            "configurations": [
                "🚀 Launch Legacy Monolith"
            ],
            "preLaunchTask": "Watch Legacy All (dev)"
        },
        {
            "name": "Attach Legacy All",
            "configurations": [
                "Attach Legacy Server",
                "Attach Legacy Pipeline",
                "Attach Legacy Worker"
            ]
        },
        {
            "name": "Launch Legacy Microservices (build)",
            "configurations": [
                "Debug Legacy Build (server)",
                "Debug Legacy Build (worker)",
                "Debug Legacy Build (pipeline)"
            ],
            "preLaunchTask": "Build Legacy Project"
        }
    ]
}