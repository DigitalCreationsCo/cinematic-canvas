{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Make Command",
      "type": "shell",
      "command": "make",
      "args": [
          "all"
      ],
      "group": {
          "kind": "build",
          "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "kill-port-3000",
      "type": "shell",
      "command": "lsof -t -i:3000 | xargs kill -9 2>/dev/null || true",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Watch Legacy Backend",
      "type": "shell",
      "command": "npx tsc -b --watch",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[.*\\] Starting compilation in watch mode\\.\\.\\.",
          "endsPattern": "^\\[.*\\] Found 0 errors\\. Watching for file changes\\."
        },
        "pattern": {
          "regexp": "^\\[.*\\] .*$"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "group": "watchers"
      }
    },
    {
      "label": "Watch Legacy Client (dev)",
      "type": "shell",
      "command": "npx vite dev --config src/server/vite.config.ts",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite-dev",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "^.*ready in.*$"
        },
        "pattern": {
          "regexp": "^.*$"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "group": "watchers",
      }
    },
    {
      "label": "Watch Legacy Client (build)",
      "type": "shell",
      "command": "npx vite build --watch --config src/server/vite.config.ts --clearScreen false --outDir ${workspaceFolder}/dist/server/public --emptyOutDir false",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite-build",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*build started.*$",
          "endsPattern": "^.*built in.*$"
        },
        "pattern": {
          "regexp": "^.*$"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "group": "watchers"
      }
    },
    {
      "label": "Watch Legacy All (dev)",
      "dependsOn": [
        "Watch Backend",
        "Watch Client (dev)"
      ],
      "dependsOrder": "parallel",
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "group": "watchers"
      }
    },
    {
      "label": "Watch Legacy All (build)",
      "dependsOn": [
        "Watch Backend",
        "Watch Client (build)"
      ],
      "dependsOrder": "parallel",
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "group": "watchers"
      }
    },
    {
      "label": "Build Legacy Project",
      "type": "shell",
      "command": "npm run build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": true
      }
    }
  ]
}