{
    "editor.fontSize": 11,
    "editor.lineHeight": 1.25,
    "terminal.integrated.fontSize": 9.5,
    "files.autoSave": "off",
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true
    },
    "js/ts": {
        "tsdk": {
            "path": "node_modules/typescript/lib",
            "promptToUseWorkspaceVersion": true,
        },
        "tsserver": {
            "automaticTypeAcquisition": {
                "enabled": false,
            },
        },
        "preferences": {
            "importModuleSpecifier": "non-relative",
        }
    },
    "typescript.tsconfig": "./tsconfig.editor.json",
    "tailwindCSS.lint.suggestCanonicalClasses": "none",
    "tailwindCSS.lint.suggestAppliedClasses": "ignore",
    "search.exclude": {
        "**/node_modules": true,
        "**/dist": true,
        "**/.next": true,
        "**/.git": true,
        "**/coverage": true,
        "**/.DS_Store": true
    },
    "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/dist/**": true,
        "**/.next/**": true,
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/coverage/**": true
    },
}