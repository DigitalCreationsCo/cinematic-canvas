# Google Cloud Platform Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_BUCKET=your-gcp-bucket-name
GOOGLE_CLOUD_REGION=us-east1
GOOGLE_CLOUD_LOCATION=global





# Promptlayer
PROMPTLAYER_API_KEY=

# Internal API Key
INTERNAL_API_KEY=

# Model Provider Config
LLM_TEXT_PROVIDER=google
LLM_VIDEO_PROVIDER=google
GOOGLE_TEXT_MODEL_NAMES=gemini-3-pro-preview,gemini-2.5-pro,gemini-1.5-flash
GOOGLE_QUALITY_EVALUATION_MODEL_NAMES=gemini-2.5-pro,gemini-1.5-pro
GOOGLE_IMAGE_MODEL_NAMES=gemini-3-pro-image-preview,gemini-2.5-flash-image
GOOGLE_VIDEO_MODEL_NAMES=veo-2.0-generate-exp,veo-1.0-generate

# LTX Endpoint Config
LTX_API_ENDPOINT=
LTX_API_KEY=

# Database
POSTGRES_URL=

# Auth configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canvas Node Persistence
# Set to 'true' to enable dual-tier persistence with IndexedDB (local) + Supabase (cloud)
# When disabled, only IndexedDB is used for local persistence
VITE_ENABLE_CLOUD_NODE_SYNC=false

# Workflow Options
EXECUTION_MODE=PARALLEL # SEQUENTIAL | PARALLEL |BATCH # batch api processing - off for now becuase google vertex ai introduces significant latency + delivery issues
MAX_PARALLEL_JOBS=2
MODEL_PRIORITY=speed # speed or quality

# Quality Config
ENABLE_QUALITY_CONTROL=true
ACCEPT_THRESHOLD=0.90
MINOR_ISSUE_THRESHOLD=0.85
MAJOR_ISSUE_THRESHOLD=0.7
FAILTHRESHOLD=0.7
MAX_RETRIES=3
SAFETY_RETRIES=2

# Debug Options
TEST_MODE=false # Mock provider responses, currently breaks the workflow as outputs are empty - needs mock outputs. (See test fixtures).
DISABLE_DB_CIRCUIT_BREAKER=false
PUBSUB_EMULATOR_HOST=
LOG_LEVEL=info
LOG_PROMPTS=true
LOCAL_AUDIO_PATH=path-to-audio-file.mp3
TEST_PROJECT_ID=""
TEAM_ID=""
USER_ID=""