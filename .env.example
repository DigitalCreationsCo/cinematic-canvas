# Google Cloud Platform Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_BUCKET_NAME=your-gcp-bucket-name
GCP_REGION=us-east1
GCP_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/credentials.json
PUBSUB_EMULATOR_HOST=

# Internal API Key
INTERNAL_API_KEY=

# Database
POSTGRES_URL=

# Logging
LOG_LEVEL=info

# Debug Options
DISABLE_DB_CIRCUIT_BREAKER=false

# Workflow Options
LOCAL_AUDIO_PATH=path-to-audio-file.mp3
EXECUTION_MODE=PARALLEL # SEQUENTIAL or PARALLEL
MAX_PARALLEL_JOBS=2

# Provider Config
LLM_TEXT_PROVIDER=google
LLM_VIDEO_PROVIDER=google

# Model Config (New plural form supports fallbacks)
# Comma-separated list of models for fallback (primary first, then fallbacks)
GOOGLE_TEXT_MODEL_NAMES=gemini-3-pro-preview,gemini-2.5-pro,gemini-1.5-flash
GOOGLE_QUALITY_EVALUATION_MODEL_NAMES=gemini-2.5-pro,gemini-1.5-pro
GOOGLE_IMAGE_MODEL_NAMES=gemini-3-pro-image-preview,gemini-2.5-flash-image
GOOGLE_VIDEO_MODEL_NAMES=veo-2.0-generate-exp,veo-1.0-generate

# LTX Endpoint Config
LTX_API_ENDPOINT=
LTX_API_KEY=

# Quality Config
ENABLE_QUALITY_CONTROL=true
ACCEPT_THRESHOLD=0.90
MINOR_ISSUE_THRESHOLD=0.85
MAJOR_ISSUE_THRESHOLD=0.7
FAILTHRESHOLD=0.7
MAX_RETRIES=3
SAFETY_RETRIES=2