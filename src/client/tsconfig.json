{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "composite": true,
        "rootDir": ".",
        "outDir": "../../dist/client",
        "paths": {
            "#client/*": [
                "./src/*"
            ],
            "#*": [
                "../*"
            ]
        },
        "types": [
            "node",
            "vite/client"
        ]
    },
    "exclude": [
        "**/node_modules",
        "**/dist",
        "**/.next",
        "**/*.test.*",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/coverage"
    ],
    "references": [
        {
            "path": "../shared"
        }
    ],
}