{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "composite": true,
        "rootDir": ".",
        "outDir": "../../dist/server",
        "paths": {
            "#*": [
                "../*"
            ]
        },
        "types": [
            "node",
            "vite/client"
        ]
    },
    "include": [
        "**/*"
    ],
    "exclude": [
        "./routes/old-index.routes.ts",
        "./old-index.ts",
        "node_modules",
        "dist",
        "coverage",
        "**/*.test.ts",
        "**/*.spec.ts",
        "**/*.test.tsx",
        "**/*.spec.tsx"
    ],
    "references": [
        {
            "path": "../shared"
        }
    ]
}