{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "composite": true,
        "rootDir": ".",
        "outDir": "../../dist/pipeline",
        "paths": {
            "#*": [
                "../*"
            ]
        }
    },
    "exclude": [
        "./old-pipeline-index.ts",
        "**/node_modules",
        "**/dist",
        "**/.next",
        "**/*.test.*",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/coverage"
    ],
    "references": [
        {
            "path": "../shared"
        }
    ]
}