{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "composite": true,
        "rootDir": ".",
        "outDir": "../../dist/shared",
        "noEmit": false,
        "paths": {
            "#*": [
                "../*"
            ]
        }
    },
    "include": [
        "**/*",
    ],
    "exclude": [
        "node_modules",
        "dist",
        "coverage",
        "**/*.test.ts",
        "**/*.spec.ts",
        "**/*.test.tsx",
        "**/*.spec.tsx"
    ]
}