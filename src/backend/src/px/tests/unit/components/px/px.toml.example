# Portals Service Configuration
#
# This file tells PX to use Portals's full-featured service implementations
# instead of the minimal/noop services built into PX.
#
# Usage:
#   1. Copy this file to your PORTALS_CONFIG_DIR as px.toml
#   2. Or add to pyproject.toml under [tool.px.services]
#
# The services will be automatically discovered and loaded when you run:
#   - portals run
#   - px serve (when run from portals project)

[services]
# Core Services - Full-featured Portals implementations
database_service = "portals.services.database.service:DatabaseService"
storage_service = "portals.services.storage.local:LocalStorageService"
cache_service = "portals.services.cache.service:ThreadingInMemoryCache"

# Authentication & Session Management
auth_service = "portals.services.auth.service:AuthService"
session_service = "portals.services.session.service:SessionService"

# Chat & Communication
chat_service = "portals.services.chat.service:ChatService"

# State & Data Management
state_service = "portals.services.state.service:StateService"
variable_service = "portals.services.variable.service:VariableService"

# Background Processing
task_service = "portals.services.task.service:TaskService"
job_queue_service = "portals.services.job_queue.service:JobQueueService"

# Marketplace & Components
store_service = "portals.services.store.service:StoreService"
shared_component_cache_service = "portals.services.shared_component_cache.service:SharedComponentCacheService"

# Observability
telemetry_service = "portals.services.telemetry.service:TelemetryService"
tracing_service = "portals.services.tracing.service:TracingService"

# Note: settings_service is NOT configurable - it always uses the built-in implementation
# Note: mcp_composer_service uses the px implementation by default
