        updatedAt: new Date(),
        error: "",
        assetKey: "scene",
        workflowId: "wf-1",
        payload: {
          sceneFields: {
            id: "new-scene-1",
            description: "A new scene",
            characterReferenceIds: ["@char1"],
            locationReferenceId: "@loc1",
          },
        },
      } as any;

      vi.mocked(mockJobControlPlane.claimJob).mockResolvedValue([job, new Date().toISOString()]);
      vi.mocked(mockJobControlPlane.updateJobSafe).mockResolvedValue(job as any);

      const mockProject = {
        id: "proj-1",
        generationRules: [],
        characters: [{ id: "c1", referenceId: "char1", name: "Character 1", assets: {} }],
        locations: [{ id: "l1", referenceId: "loc1", name: "Location 1", assets: {} }],
        scenes: [],
      };
      vi.mocked(mockProjectRepo.getProjectFullState).mockResolvedValue(mockProject as any);
      vi.mocked(mockProjectRepo.createCharacters).mockResolvedValue([{ id: "c2", name: "New Char" }]);
      vi.mocked(mockProjectRepo.createLocations).mockResolvedValue([{ id: "l2", name: "New Loc" }]);
      vi.mocked(mockProjectRepo.createScenes).mockResolvedValue([{ id: "s1" }]);

      // Mock KBHydrator
      const mockKBHydrator = { extractAndResolveMentions: vi.fn().mockResolvedValue({ handlesResolved: [], textPlain: "" }) };
      vi.mocked(KBHydrator).mockImplementation(function () { return mockKBHydrator; } as any);

