{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "../dist/website/tsbuildinfo",
    "rootDir": ".",
    "outDir": "../dist/website",
    "esModuleInterop": true,
    "paths": {
      "#/*": [
        "./*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
  },
  "references": [
    {
      "path": "../src/shared"
    }
  ],
  "include": [
    "**/*",
    "**/*.ts",
    "**/*.tsx",
    "**/*.json",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
}