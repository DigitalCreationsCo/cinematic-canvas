      flex-direction: column;
      align-items: flex-start;
      text-align: left;
    }

    .workflow-container .section-title {
      margin-bottom: 40px;
    }

    /* ── Steps Horizontal Row ──
         Two-layer approach to avoid flex overflow clipping bugs:
           .steps-viewport  → overflow: hidden (clips the visible area)
           .steps-row       → flex row, translates inside the viewport
    */
    .steps-viewport {
      overflow: hidden;
      width: 100%;
      align-self: center;
      text-align: center;
    }

    .steps-row {
      position: relative;
      display: flex;
      width: max-content;
      transition: transform 0.45s cubic-bezier(0.23, 1, 0.32, 1);
