---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Home" description="The AI Storytelling Workspace">
  <main class="editor-root relative w-full pt-[var(--nav-height)]">
    <!-- Hero Section -->
    <section id="hero">
      <div class="hero-bg">
        <div class="hero-bg-gradient-1"></div>
        <div class="hero-bg-gradient-2"></div>
        <div class="hero-bg-gradient-3"></div>
      </div>
      <div class="hero-lines"></div>

      <p class="hero-eyebrow">The AI Storytelling Workspace</p>

      <h1 class="hero-title">
        Where <span class="outline-text">stories</span>
        <br />
        become <em>worlds</em>
      </h1>

      <p class="hero-subtitle">
        A generative filmmaking workspace for directors, screenwriters, and
        authors. From first concept to final frame — powered by AI.
      </p>

      <div class="hero-actions">
        <a href="#features" class="btn-ghost">Explore Features</a>
        <a href="/docs" class="btn-primary">Begin Your Story</a>
      </div>
    </section>

    <!-- Ticker Section -->
