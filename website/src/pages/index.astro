  <script>
    // Stats counter animation
    const animateCounter = (el: Element, target: number) => {
      let start = 0;
      const dur = 1800;
      const step = (timestamp: number) => {
        if (!start) start = timestamp;
        const p = Math.min((timestamp - start) / dur, 1);
        const eased = 1 - Math.pow(1 - p, 3);
        const current = Math.floor(eased * target);
        const spans = el.querySelectorAll("span");
        let suf = "";
        spans.forEach((s) => (suf += s.outerHTML));
        el.innerHTML =
          (current >= 1000
            ? (current / 1000).toFixed(current % 1000 === 0 ? 0 : 0) + "K"
            : current) + suf;
        if (p < 1) requestAnimationFrame(step);
        else
          el.innerHTML = (target >= 1000 ? target / 1000 + "K" : target) + suf;
      };
      requestAnimationFrame(step);
    };

    const statObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            const el = e.target;
            const target = parseInt((el as HTMLElement).dataset.target || "0");
            animateCounter(el, target);
            statObserver.unobserve(el);
          }
        });
      },
      { threshold: 0.5 },
    );
    document
      .querySelectorAll("[data-target]")
      .forEach((el) => statObserver.observe(el));

    // Sprocket holes generation
    document.querySelectorAll(".sprocket-strip").forEach((strip) => {
      const count = Math.ceil(window.innerHeight / 26);
      strip.innerHTML = "";
      for (let i = 0; i < count; i++) {
        const h = document.createElement("div");
        h.className = "sprocket-hole";
        strip.appendChild(h);
      }
    });

    // scroll-feature-item hover animation: expand left-to-right, shrink right-to-left
    document.querySelectorAll(".scroll-feature-item").forEach((item) => {
      const pseudo = getComputedStyle(item, "::before");
      const existing = document.createElement("div");
      existing.style.setProperty("--current-scale", "0");
      item.appendChild(existing);

      item.addEventListener("mouseenter", () => {
        // Animate left → right
        (item as HTMLElement).style.setProperty("--hover-origin", "left");
        (item as HTMLElement).style.setProperty("--hover-scale", "1");
      });

      item.addEventListener("mouseleave", () => {
        // Animate right → left
        (item as HTMLElement).style.setProperty("--hover-origin", "right");
        (item as HTMLElement).style.setProperty("--hover-scale", "0");
      });
    });

    // Hero video sizing: align top to the H1 top and fill area to bottom target.
    function resizeHeroVideo() {
      const hero = document.getElementById('hero');
      if (!hero) return;
      const vid = hero.querySelector('.hero-video');
      const h1 = hero.querySelector('.hero-title');
      const heroInner = hero.querySelector('.hero-inner');
      const cta = hero.querySelector('.hero-actions');
      if (!vid || !h1 || !heroInner) return;

      // Ensure the hero section is positioned for absolute children
      if (getComputedStyle(hero).position === 'static') hero.style.position = 'relative';
      heroInner.style.position = heroInner.style.position || 'relative';
      heroInner.style.zIndex = 10;

      const heroRect = hero.getBoundingClientRect();
      const h1Rect = h1.getBoundingClientRect();
      const heroInnerRect = heroInner.getBoundingClientRect();

      const topOffset = Math.max(0, h1Rect.top - heroRect.top);

      let bottomOffset;
      // Desktop: use bottom of heroInner. Mobile: use bottom of CTA if present.
      if (window.matchMedia('(min-width:1024px)').matches) {
        bottomOffset = heroInnerRect.bottom - heroRect.top;
      } else {
        if (cta) bottomOffset = Math.max(heroInnerRect.bottom - heroRect.top, cta.getBoundingClientRect().bottom - heroRect.top);
        else bottomOffset = heroInnerRect.bottom - heroRect.top;
      }

      const height = Math.max(0, bottomOffset - topOffset);

      Object.assign(vid.style, {
        position: 'absolute',
        left: '0',
        top: `${topOffset}px`,
        width: '100vw',
        height: `${height}px`,
        objectFit: 'cover',
        zIndex: '0',
        pointerEvents: 'none',
      });

      // Ensure the video horizontally fills the viewport without shifting layout
      // and that content remains above it.
      vid.style.maxWidth = 'none';
    }

    window.addEventListener('resize', resizeHeroVideo);
    window.addEventListener('orientationchange', resizeHeroVideo);
    // Run after load and with a short delay to catch fonts/layout.
    document.addEventListener('DOMContentLoaded', () => { resizeHeroVideo(); setTimeout(resizeHeroVideo, 150); });

    // IntersectionObserver for all videos: show & play the first intersecting video
    // in document order; hide & pause others. Keeps layout stable (uses
    // visibility/opacity), and updates as the user scrolls.
    (function manageVideosByIntersection() {
      const videos = Array.from(document.querySelectorAll('video'));
      if (!videos.length) return;

      // Initialize styles without affecting layout
      videos.forEach((v) => {
        v.style.transition = v.style.transition || 'opacity 200ms linear';
        // Start hidden until observer updates visibility to avoid flash
        if (!v.hasAttribute('data-observer-initialized')) {
          v.style.opacity = '0';
          v.style.visibility = 'hidden';
          v.setAttribute('data-observer-initialized', '1');
        }
      });

      const intersecting = new Map();

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          intersecting.set(entry.target, entry.isIntersecting && entry.intersectionRatio > 0);
        });

        // Choose the first video (document order) that is intersecting
        const firstVisible = videos.find((v) => intersecting.get(v));

        videos.forEach((v) => {
          if (v === firstVisible) {
            // show and play
            v.style.visibility = 'visible';
            v.style.opacity = '1';
            if (v.paused) {
              const p = v.play();
              if (p && p.catch) p.catch(() => {});
            }
          } else {
            // hide and pause (do not remove from layout)
            v.style.opacity = '0';
            v.style.visibility = 'hidden';
            if (!v.paused) {
              try { v.pause(); } catch (e) {}
            }
          }
        });
      }, { threshold: 0.35 });

      videos.forEach((v) => observer.observe(v));

      // Re-evaluate on resize/orientation changes since layout shifts can change intersection
      window.addEventListener('resize', () => observer.takeRecords() && observer);
      window.addEventListener('orientationchange', () => observer.takeRecords() && observer);
    })();
  </script>
</BaseLayout>
