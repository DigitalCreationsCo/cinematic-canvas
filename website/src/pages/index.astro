      overflow: clip;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    /* ── Workflow — Scroll Track ── */
    .workflow-track {
      position: relative;
      width: 100%;
      /* height set dynamically in JS: NUM_STEPS × window.innerHeight */
    }

    .workflow-sticky {
      position: sticky;
      top: 0;
      height: 100vh;   /* fallback for browsers that don't support dvh */
      height: 100dvh;  /* modern: excludes URL bar area on mobile */
      overflow: clip;
      display: flex;
      flex-direction: column;
      justify-content: center;
      z-index: 1;
