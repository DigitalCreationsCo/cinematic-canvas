      border: 1px solid color-mix(in srgb, var(--color-gold), transparent 70%);
      padding: 3px 10px;
    }

    /* ── Feature Grid (2 columns, shifted by JS at row boundary) ── */
    .features-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--gap-inline);
      transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
    }

    .feature-card {
      padding: 52px 48px;
      position: relative;
      overflow: hidden;
      transition: background 0.3s !important;
    }

    .feature-card:hover {
      background: var(--card) !important;
    }

    .feature-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      transform: scaleX(var(--hover-scale, 0));
      transform-origin: var(--hover-origin, left);
      transition: transform 0.5s cubic-bezier(0.23, 1, 0.32, 1);
    }

    .feature-card:hover::before {
      transform: scaleX(1);
      transform-origin: left;
    }

    /* ── Shared video player ──
         NOTE: The JS sequencer controls opacity entirely via inline style.
         - Fade-out uses this CSS transition (element stays in old card).
         - Fade-in uses manual rAF interpolation (reliable after DOM move).
         The CSS `opacity: 0.35` below is a fallback — at rest, .hero-grain
         (0.5) beats it in specificity. Hover uses !important to temporarily
         override the inline style.                    ── */
    .feature-card-video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      z-index: 0;
      pointer-events: none;
      opacity: 0.35;
      transition: opacity 0.15s ease;
    }

    .feature-card:hover .feature-card-video {
      opacity: 0.55 !important;
    }

    .feature-card .foreground-layer {
      position: relative;
      z-index: 2;
    }

    /* ── Section alignment helpers ── */
    .section-label-centered {
      justify-content: center;
    }

    .section-title-centered {
      margin: 0 auto;
      text-align: center;
    }

    /* ── CTA content wrapper ── */
    .cta-content {
      position: relative;
      z-index: 2;
    }

    .cta-content .hero-subtitle {
      margin: 24px auto 34px;
      max-width: 500px;
      text-align: center;
    }

    .hero-actions-centered {
      justify-content: center;
    }

    /* ── Responsive ── */

    @media (max-width: 1024px) {
      .features-grid {
        grid-template-columns: 1fr;
      }

