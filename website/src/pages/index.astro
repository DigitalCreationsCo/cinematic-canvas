---
import PortalsCanvas from "../components/PortalsCanvas";
import siteConfig from "../../site.json";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Home" description="The AI Storytelling Workspace">
  <main class="editor-root relative w-full">
    <!-- ═══════════════════════════════════════════════════════
         HERO
         ═══════════════════════════════════════════════════════ -->
    <section id="hero">
      <p class="hero-eyebrow">
        The production workspace for directors
      </p>
      <div class="hero-inner">
        <div class="hero-bg hero-grain">
          <video
            src="/videos/ive-come-for-you-bodalia/01.mp4"
            class="hero-video"
            autoplay
            loop
            muted
            playsinline
          ></video>
          <div class="hero-bg-gradient-1"></div>
          <div class="hero-bg-gradient-2"></div>
          <div class="hero-bg-gradient-3"></div>
        </div>
        <div class="hero-inner-content">
          <h1 class="hero-title">
            Where <span>stories</span>
            <br />
            become <em>worlds</em>
          </h1>
        </div>
      </div>
      <div class="hero-actions">
        <a href="#features" class="btn-ghost">Explore Features</a>
        <a href="/docs" class="btn-primary">Start Creating</a>
      </div>
    </section>

    <section id="workflow-track" class="workflow-track">
      <div id="workflow-sticky" class="workflow-sticky">
        <div class="hero-lines"></div>
        <div class="workflow-container">
          <p class="section-label">Every tool your story demands</p>
          <h2 class="section-title">
            From idea<br class="mobile-only" />
            to <em>final cut</em><br />
            in one workspace
          </h2>

          <div class="steps-viewport">
            <div id="steps-row" class="steps-row">
              <div id="steps-line" class="steps-line"></div>

              <div class="workflow-step" data-index="0">
                <div class="step-circle">
                  <svg viewBox="0 0 24 24">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                  </svg>
                </div>
                <h4 class="step-title">Concept</h4>
                <p class="step-desc">
                  Drop your seed idea. The AI helps you develop premise,
                  genre, tone, and theme.
                </p>
              </div>

              <div class="workflow-step" data-index="1">
                <div class="step-circle">
                  <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M12 8v4l3 3"></path>
                  </svg>
                </div>
                <h4 class="step-title">Structure</h4>
                <p class="step-desc">
                  Build your three-act framework, sequences, and beat sheet
                  with intelligent scaffolding.
                </p>
              </div>

              <div class="workflow-step" data-index="2">
                <div class="step-circle">
                  <svg viewBox="0 0 24 24">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path>
                  </svg>
                </div>
                <h4 class="step-title">Characters</h4>
                <p class="step-desc">
                  Build your cast with deep psychological profiles, voices,
                  and relational dynamics.
                </p>
              </div>

              <div class="workflow-step" data-index="3">
                <div class="step-circle">
                  <svg viewBox="0 0 24 24">
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                  </svg>
                </div>
                <h4 class="step-title">Write</h4>
                <p class="step-desc">
                  Draft scenes, dialogue, and action lines with your AI
                  co-writer always available.
                </p>
              </div>

              <div class="workflow-step" data-index="4">
                <div class="step-circle">
                  <svg viewBox="0 0 24 24">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                  </svg>
                </div>
                <h4 class="step-title">Export</h4>
                <p class="step-desc">
                  Output industry-standard formats: Final Draft, Fountain,
                  PDF, or shoot-ready storyboards.
                </p>
              </div>
            </div>
          </div>

          <div id="connected-wrap" class="connected-wrap">
            <div class="connected-content" data-step="0">
              <div class="connected-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              </div>
              <h3 class="connected-title">From spark to blueprint</h3>
              <p class="connected-desc">
                AI helps you develop premise, genre, tone, and theme.
                Your seed idea grows into a fully-formed concept before
                you write a single word.
              </p>
              <div class="connected-tags">
                <span>Premise</span>
                <span>Genre</span>
                <span>Tone</span>
              </div>
            </div>

            <div class="connected-content" data-step="1">
              <div class="connected-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="12" cy="12" r="10"/>
                  <path d="M12 8v4l3 3"/>
                </svg>
              </div>
              <h3 class="connected-title">Blueprint your narrative</h3>
              <p class="connected-desc">
                Build your three-act framework, sequences, and beat sheet
                with intelligent scaffolding. Your story's architecture
                takes shape in minutes, not days.
              </p>
              <div class="connected-tags">
                <span>Three-Act</span>
                <span>Sequences</span>
                <span>Beat Sheet</span>
              </div>
            </div>

            <div class="connected-content" data-step="2">
              <div class="connected-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                  <circle cx="9" cy="7" r="4"/>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
              </div>
              <h3 class="connected-title">Breathe life into your cast</h3>
              <p class="connected-desc">
                Deep psychological profiles, voice profiling, and
                relationship mapping keep your characters consistent
                across your entire narrative arc.
              </p>
              <div class="connected-tags">
                <span>Profiles</span>
                <span>Voices</span>
                <span>Relationships</span>
              </div>
            </div>

            <div class="connected-content" data-step="3">
              <div class="connected-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
                  <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/>
                </svg>
              </div>
              <h3 class="connected-title">Your voice, amplified</h3>
              <p class="connected-desc">
                Draft scenes, dialogue, and action lines with your AI
                co-writer always in sync. Cinematic pacing, subtext,
                and visual language — all in your unique voice.
              </p>
              <div class="connected-tags">
                <span>Scenes</span>
                <span>Dialogue</span>
                <span>Pacing</span>
              </div>
            </div>

            <div class="connected-content" data-step="4">
              <div class="connected-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14 2 14 8 20 8"/>
                </svg>
              </div>
              <h3 class="connected-title">Ready for production</h3>
              <p class="connected-desc">
                Output industry-standard formats at your fingertips.
                Final Draft, Fountain, PDF, or shoot-ready storyboards
                — seamless export for any production pipeline.
              </p>
              <div class="connected-tags">
                <span>Final Draft</span>
                <span>PDF</span>
                <span>Storyboard</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

