    // ── Counter Animation ──
    const animateCounter = (el, target) => {
      let start = 0;
      const dur = 1800;
      const step = (timestamp) => {
        if (!start) start = timestamp;
        const p = Math.min((timestamp - start) / dur, 1);
        const eased = 1 - Math.pow(1 - p, 3);
        const current = Math.floor(eased * target);
        const spans = el.querySelectorAll("span");
        let suf = "";
        spans.forEach((s) => (suf += s.outerHTML));
        el.innerHTML =
          (current >= 1000
            ? (current / 1000).toFixed(current % 1000 === 0 ? 0 : 0) + "K"
            : current) + suf;
        if (p < 1) requestAnimationFrame(step);
        else
          el.innerHTML =
            (target >= 1000 ? target / 1000 + "K" : target) + suf;
      };
      requestAnimationFrame(step);
    };

    const statObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            const el = e.target;
            const target = parseInt(el.dataset.target || "0");
            animateCounter(el, target);
            statObserver.unobserve(el);
          }
        });
      },
      { threshold: 0.5 },
    );
    document
      .querySelectorAll("[data-target]")
      .forEach((el) => statObserver.observe(el));

    // ═══════════════════════════════════════════════════════════
    // WORKFLOW — Scroll-Controlled Step Sequencer
    // ═══════════════════════════════════════════════════════════
    //
    // Hijacks scroll within a sticky track. Each viewport of scroll
    // advances one workflow step:
    //   - steps row translates horizontally (revealing one step at a time)
    //   - connected content fades to show the current step's details
    //   - after the last step, normal scroll resumes
    //
    // Extensible: add/remove .workflow-step and .connected-content pairs.
    //
    (function initWorkflowSequencer() {
      const track = document.getElementById("workflow-track");
      const viewport = document.querySelector(".steps-viewport");
      const stepsRow = document.getElementById("steps-row");
      const line = document.getElementById("steps-line");
      const steps = Array.from(
        document.querySelectorAll(".steps-row .workflow-step"),
      );
      const connectedContents = Array.from(
        document.querySelectorAll(".connected-wrap .connected-content"),
      );

      const NUM_STEPS = steps.length;
      if (!track || !viewport || !stepsRow || !line || NUM_STEPS === 0) return;

      // ── Bootstrap sizes (runs once + on resize) ──
      function measure() {
        // Each step must be exactly the viewport width
        const vw = viewport.offsetWidth;
        stepsRow.style.setProperty("--step-width", vw + "px");
        // The line spans from first step circle to last step circle
        line.style.width = stepsRow.scrollWidth + "px";
        // Track height: one viewport per step (pixels, not vh —
        // avoids iOS Safari URL-bar 100vh quirks)
        track.style.height = `${NUM_STEPS * window.innerHeight}px`;
      }
      measure();

      // ── State ──
      let activeIndex = 0; // start at step 0

      function setStepIndex(index) {
        if (index === activeIndex) return;

        // Horizontal translate the steps row by one step width
        const stepWidth = steps[0].offsetWidth;
        stepsRow.style.transform = `translateX(-${index * stepWidth}px)`;

        // Crossfade connected content via CSS transitions (class toggle)
        connectedContents.forEach((el, i) => {
          el.classList.toggle("active", i === index);
        });

        activeIndex = index;
      }

      // ── Set initial state (step 0 visible) ──
      connectedContents.forEach((el, i) => {
        el.classList.toggle("active", i === 0);
      });

      // ── Scroll handler ──
      let rafScheduled = false;

      function onScroll() {
        const rect = track.getBoundingClientRect();
        const vh = window.innerHeight;

        // Track out of viewport → no-op (don't reset so the last
        // visible state stays)
        if (rect.bottom < 0 || rect.top > vh) {
          rafScheduled = false;
          return;
        }

        // Calculate progress (0–1) through the track
        const scrolled = -rect.top;
        const maxScroll = Math.max(track.offsetHeight - vh, 1);
        const progress = Math.max(0, Math.min(1, scrolled / maxScroll));

        // Map to step index (clamped)
        const targetIndex = Math.min(
          Math.floor(progress * NUM_STEPS),
          NUM_STEPS - 1,
        );

        setStepIndex(targetIndex);
        rafScheduled = false;
      }

      window.addEventListener(
        "scroll",
        () => {
          if (!rafScheduled) {
            requestAnimationFrame(onScroll);
            rafScheduled = true;
          }
        },
        { passive: true },
      );

      // Re-measure on resize (step width and line width may change)
      window.addEventListener("resize", measure);

      // Initial check in case workflow is already visible
      onScroll();
    })();

