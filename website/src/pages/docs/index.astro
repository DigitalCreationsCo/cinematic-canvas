---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Docs" description="Documentation for Cinematic Canvas">
  <main class="editor-root relative w-full">
    
    <div class="docs-layout">
      <aside class="docs-sidebar">
        <nav class="docs-nav">
          <div class="nav-section">
            <h3 class="nav-section-title">Getting Started</h3>
            <a href="/docs/getting-started/installation" class="nav-link">Installation</a>
            <a href="/docs/getting-started/configuration" class="nav-link">Configuration</a>
            <a href="/docs/getting-started/troubleshooting" class="nav-link">Troubleshooting</a>
          </div>
          
          <div class="nav-section">
            <h3 class="nav-section-title">Features</h3>
            <a href="/docs/features/ltx-video" class="nav-link">LTX Video</a>
            <a href="/docs/features/reliability" class="nav-link">Reliability</a>
            <a href="/docs/features/workflow-control" class="nav-link">Workflow Control</a>
            <a href="/docs/features/continuity" class="nav-link">Continuity</a>
            <a href="/docs/features/audio" class="nav-link">Audio Processing</a>
          </div>
          
          <div class="nav-section">
            <h3 class="nav-section-title">Architecture</h3>
            <a href="/docs/architecture/overview" class="nav-link">Overview</a>
            <a href="/docs/architecture/core-system" class="nav-link">Core System</a>
            <a href="/docs/architecture/state-management" class="nav-link">State Management</a>
            <a href="/docs/architecture/prompt-engineering" class="nav-link">Prompt Engineering</a>
          </div>
        </nav>
      </aside>

      <article class="docs-content">
        <header class="docs-header">
          <h1>Cinematic Canvas Documentation</h1>
          <p class="docs-lead">
            Welcome to the Cinematic Canvas documentation. Here you'll find everything you need to build 
            cinematic worlds with AI-assisted storytelling.
          </p>
        </header>

        <section class="docs-section">
          <h2>Quick Start</h2>
          <p>Get up and running in minutes:</p>
          
          <pre class="code-block"><code>npm install @cinematiccanvas/core
npm run dev</code></pre>
          
          <p>Open <a href="http://localhost:5173">http://localhost:5173</a> to access the workspace.</p>
        </section>

        <section class="docs-section">
          <h2>Core Concepts</h2>
          
          <h3>Projects</h3>
          <p>A project is the top-level container for your creative work. Each project contains scenes, characters, locations, and assets.</p>
          
          <h3>Worlds</h3>
          <p>A world is a shared narrative universe within a project. Worlds contain lore, rules, and continuity constraints that apply across all scenes.</p>
          
          <h3>Entities</h3>
          <p>Entities are the building blocks of your story: characters, locations, props, and references. Each entity maintains identity across scenes.</p>
        </section>

        <section class="docs-section">
          <h2>Next Steps</h2>
          <ul class="docs-links">
            <li><a href="/docs/getting-started/installation">Installation Guide →</a></li>
            <li><a href="/docs/features/ltx-video">Learn about LTX Video →</a></li>
            <li><a href="/docs/architecture/overview">Architecture Overview →</a></li>
          </ul>
        </section>
      </article>
    </div>

  </main>
</BaseLayout>

<style>
  .docs-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 60px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 120px clamp(20px, 5vw, 60px) 80px;
    min-height: calc(100vh - var(--nav-height));
  }

  .docs-sidebar {
    position: sticky;
    top: 100px;
    height: fit-content;
  }

  .docs-nav {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .nav-section-title {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 12px;
  }

  .nav-link {
    display: block;
    font-size: 0.85rem;
    color: var(--color-muted-warm);
    text-decoration: none;
    padding: 6px 0;
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: var(--color-warm);
  }

  .docs-content {
    max-width: 720px;
  }

  .docs-header {
    margin-bottom: 48px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--border-glass);
  }

  .docs-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 300;
    color: var(--color-warm);
    margin-bottom: 16px;
  }

  .docs-lead {
    font-size: 1.1rem;
    color: var(--color-muted-warm);
    line-height: 1.7;
  }

  .docs-section {
    margin-bottom: 48px;
  }

  .docs-section h2 {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 400;
    color: var(--color-warm);
    margin-bottom: 20px;
  }

  .docs-section h3 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--color-warm);
    margin: 32px 0 12px;
  }

  .docs-section p {
    font-size: 1rem;
    color: var(--color-warm-dim);
    line-height: 1.7;
    margin-bottom: 16px;
  }

  .docs-section a {
    color: var(--color-gold);
    text-decoration: none;
  }

  .docs-section a:hover {
    text-decoration: underline;
  }

  .code-block {
    background: var(--color-surface);
    border: 1px solid var(--border-glass);
    border-radius: 6px;
    padding: 20px;
    margin: 16px 0;
    overflow-x: auto;
  }

  .code-block code {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-warm);
  }

  .docs-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .docs-links li {
    margin-bottom: 12px;
  }

  @media (max-width: 1024px) {
    .docs-layout {
      grid-template-columns: 1fr;
    }

    .docs-sidebar {
      display: none;
    }
  }
</style>