---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const updates = await getCollection("updates");
  return updates.map((update) => ({
    params: { slug: update.slug },
    props: { update },
  }));
}

const { update } = Astro.props;
const { Content } = await render(update);
const allUpdates = await getCollection("updates");

const formatDate = (dateInput: unknown) => {
  const date =
    typeof dateInput === "string" ? new Date(dateInput) : (dateInput as Date);
  return date;
};

const updateDate = formatDate(update.data.date);
const sortedUpdates = allUpdates.sort((a, b) => {
  const dateA = formatDate(a.data.date);
  const dateB = formatDate(b.data.date);
  return dateB.getTime() - dateA.getTime();
});
---

<BaseLayout title={update.data.title} description={update.data.description}>
  <div class="update-page enable-selection cursor-auto">
    <!-- Cover Image -->
    {
      update.data.coverImage && (
        <img
          class="update-cover-image"
          src={update.data.coverImage}
          alt={update.data.title}
        />
      )
    }

    <!-- Left Sidebar -->
    <aside class="update-sidebar">
      <h3 class="sidebar-title">All Updates</h3>
      <nav class="sidebar-nav">
        {
          allUpdates.map((u) => {
            const isActive = u.slug === update.slug;
            return (
              <a
                href={`/updates/${u.slug}`}
                class={`sidebar-link ${isActive ? "active" : ""}`}
              >
                <span class="link-title">{u.data.title}</span>
                <span class="link-date">
                  {formatDate(u.data.date).toLocaleDateString(undefined, {
                    month: "short",
                    day: "numeric",
                    year: "numeric",
                  })}
                </span>
              </a>
            );
          })
        }
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="update-main">
      <article class="update-article">
        <header class="update-header">
          <time class="update-date">
            {
              formatDate(update.data.date).toLocaleDateString(undefined, {
                year: "numeric",
                month: "long",
                day: "numeric",
              })
            }
          </time>
          <h1 class="update-title" style={{ fontSize: "var(--size-title)" }}>{update.data.title}</h1>

          {
            update.data.authors && update.data.authors.length > 0 && (
              <div class="update-authors">
                <div class="author-avatars">
                  {update.data.authors.map((author: string) => (
                    <div class="author-avatar" title={author}>
                      {author.charAt(0).toUpperCase()}
                    </div>
                  ))}
                </div>
                <div class="author-info">
                  <span class="author-names">
                    {update.data.authors.join(", ")}
                  </span>
                </div>
              </div>
            )
          }
        </header>

        <div class="update-content">
          <Content />
        </div>
      </article>
    </main>
  </div>
</BaseLayout>

<style>
  .update-page {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 40px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 120px clamp(20px, 5vw, 60px) 80px;
  }

  .update-cover-image {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 200px;
    object-cover: cover;
    z-index: -1;
    opacity: 0.3;
  }

  .update-sidebar {
    position: sticky;
    top: 100px;
    height: fit-content;
  }

  .sidebar-title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 24px;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .sidebar-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 16px;
    border-left: 2px solid transparent;
    text-decoration: none;
    color: var(--color-muted-warm);
    transition: all 0.2s;
  }

  .sidebar-link:hover {
    border-left-color: var(--border-glass);
    color: var(--color-warm);
  }

  .sidebar-link.active {
    border-left-color: var(--color-gold);
    color: var(--color-warm);
  }

  .link-title {
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .link-date {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-muted-warm);
  }

  .update-main {
    min-width: 0;
  }

  .update-article {
    max-width: 720px;
  }

  .update-header {
    margin-bottom: 48px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--border-glass);
  }

  .update-date {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold);
    display: block;
    margin-bottom: 16px;
  }

  .update-article .update-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 300;
    line-height: 1.2;
    color: var(--color-warm);
    margin-bottom: 24px;
  }

  .update-authors {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .author-avatars {
    display: flex;
  }

  .author-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-gold-dim);
    border: 2px solid var(--background);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--color-gold);
  }

  .author-info {
    display: flex;
    flex-direction: column;
  }

  .author-names {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-warm);
  }

  .author-titles {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-muted-warm);
  }

  .update-content {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--color-warm-dim);
  }

  .update-content :global(h2) {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 400;
    color: var(--color-warm);
    margin: 48px 0 24px;
  }

  .update-content :global(h3) {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 400;
    color: var(--color-warm);
    margin: 36px 0 16px;
  }

  .update-content :global(p) {
    margin-bottom: 20px;
  }

  .update-content :global(ul),
  .update-content :global(ol) {
    margin: 20px 0;
    padding-left: 24px;
  }

  .update-content :global(li) {
    margin-bottom: 8px;
  }

  .update-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--color-gold-dim);
    padding: 2px 6px;
    border-radius: 3px;
  }

  .update-content :global(pre) {
    background: var(--color-surface);
    padding: 20px;
    border-radius: 6px;
    overflow-x: auto;
    margin: 24px 0;
  }

  .update-content :global(img) {
    max-width: 100%;
    border-radius: 6px;
    margin: 24px 0;
  }

  .update-content :global(blockquote) {
    border-left: 3px solid var(--color-gold);
    padding-left: 20px;
    margin: 24px 0;
    font-style: italic;
    color: var(--color-muted-warm);
  }

  @media (max-width: 1024px) {
    .update-page {
      grid-template-columns: 1fr;
    }

    .update-sidebar {
      display: none;
    }
  }

  .enable-selection {
    -webkit-user-select: text;
    -ms-user-select: text;
    user-select: text;
  }
</style>
