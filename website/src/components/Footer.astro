---
const currentYear = new Date().getFullYear();
const pathname = Astro.url.pathname;
const isHome = pathname === "/";
---

<footer class="footer">
  <div class="footer-main">
    <div class="footer-inner">
      <div class="footer-brand w-[260px]">
        <div class="footer-logo">
          <span class="footer-logo-text"
            >Cinematic <span class="italic text-[var(--color-gold)]"
              >Canvas</span
            ></span
          >
        </div>
        <p class="footer-tagline">
          The AI storytelling workspace for directors, screenwriters, and
          authors. From first concept to final frame — powered by AI.
        </p>
      </div>

      <div class="footer-col">
        <h4 class="footer-col-title">Product</h4>
        <ul class="footer-links">
          <li><a href="/docs">Documentation</a></li>
          <li><a href="/updates">Release Notes</a></li>
          <li><a href="/gallery">Gallery</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="footer-col-title">Resources</h4>
        <ul class="footer-links">
          <li><a href="/docs/getting-started">Getting Started</a></li>
          <li><a href="/docs/features">Features</a></li>
          <li><a href="/docs/guides">Guides</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="footer-col-title">Company</h4>
        <ul class="footer-links">
          <li><a href="#">About</a></li>
          <li><a href="#">Contact</a></li>
          <li><a href="#">Twitter</a></li>
        </ul>
      </div>
    </div>
  </div>

  {
    isHome && (
      <span class="footer-logo-text-underlay">
        Cinematic{" "}
        <>
          <span class="italic text-[var(--color-gold)]">Canvas</span>
          <span class="text-2xl">&copy;</span>
        </>
      </span>
    )
  }

  <div class="footer-bottom">
    <p class="footer-copy">
      &copy; {currentYear}
      <span class="uppercase">Cinematic Canvas</span>. All rights reserved.
    </p>
  </div>
</footer>

<style>
  @reference "../styles/global.css";

  .footer {
    border-top: 1px solid var(--color-border-subtle);
    padding: 60px clamp(20px, 5vw, 60px) 0;
    background: color-mix(in srgb, var(--color-background), transparent 100%);
    margin-top: auto;
  }

  .footer-main {
    max-width: 1400px;
    width: 100%;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 60px;
  }

  .footer-inner {
    display: contents;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }

  .footer-logo-mark {
    width: 28px;
    height: 28px;
    background: linear-gradient(
      135deg,
      var(--color-gold) 0%,
      var(--color-accent-red) 100%
    );
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
  }

  .footer-logo-text {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
    font-weight: 500;
    text-align: center;
    width: min-content;
    margin-right: auto;
    margin-left: auto;
    @apply uppercase font-heading tracking-tight;
  }

  .footer-logo-text-underlay {
    position: relative;
    padding-top: 40px;
    bottom: 0;
    z-index: -1;
    font-family: var(--font-display);
    font-size: var(--size-display);
    line-height: 1;
    font-weight: 500;
    text-align: center;
    width: min-content;
    margin: 0 auto;
    @apply uppercase font-heading tracking-tight;
  }

  .footer-tagline {
    font-size: 0.82rem;
    color: var(--color-muted-foreground);
    line-height: 1.6;
    max-width: 260px;
  }

  .footer-col-title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 16px;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links li {
    margin-bottom: 6px;
  }

  .footer-links a {
    color: var(--color-muted-foreground);
    text-decoration: none;
    font-size: 0.82rem;
    transition: color 0.2s;
    padding: 4px 2px;
  }

  .footer-links a:hover {
    color: var(--color-warm);
  }

  .footer-bottom {
    width: 100%;
    max-width: 1400px;
    margin: 48px auto 0;
    padding: 24px clamp(20px, 5vw, 60px);
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-copy {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-muted-foreground);
    letter-spacing: 0.08em;
  }

  @media (max-width: 1024px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
