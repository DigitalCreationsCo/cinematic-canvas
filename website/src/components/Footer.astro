---
import siteConfig from '../../site.json';

const currentYear = new Date().getFullYear();
const pathname = Astro.url.pathname;
const isHome = pathname === "/";
---

<footer class="footer">
  <div class="footer-main">
    <!-- Row 1: Headers, all bottom-aligned with the logo text's bottom -->
    <div class="footer-logo-area">
      <span class="footer-logo-text-underlay">
        {siteConfig.name}
        <span class="text-2xl">&copy;</span>
      </span>
    </div>

    <div class="footer-header-prod"><h4>Product</h4></div>
    <div class="footer-header-comp"><h4>Company</h4></div>

    <!-- Row 2: Body content, all top-aligned with the tagline's top -->
    <div class="footer-brand-content">
      <p class="footer-tagline">
        {siteConfig.description}
      </p>
      <br />
      <p class="footer-copy">
        &copy; {currentYear}
        <span class="lowercase">{siteConfig.name}</span>. All rights reserved.
      </p>
    </div>

    <div class="footer-links-prod">
      <ul class="footer-links">
        <li><a href="/docs/getting-started">Getting Started</a></li>
        <li><a href="/docs">Documentation</a></li>
        <li><a href="/updates">Release Notes</a></li>
      </ul>
    </div>

    <div class="footer-links-comp">
      <ul class="footer-links">
        <li><a href="#">Contact Us</a></li>
        <li><a href="#">About</a></li>
        <li><a href="#">Twitter</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  @reference "../styles/global.css";

  .footer {
    border-top: 1px solid var(--color-border-subtle);
    background: color-mix(in srgb, var(--color-background), transparent 100%);
    margin-top: auto;
    padding-top: 60px;
  }

  .footer-main {
    max-width: 1400px;
    width: 100%;
    margin: 0 auto;
    display: grid;
    grid-template-areas:
      "logo    header-prod header-comp"
      "content links-prod  links-comp";
    grid-template-columns: 1fr 1fr 1fr;
    gap: 24px 48px;
    padding: 30px clamp(0px, 5vw, 60px) 60px;
  }

  /* ── Row 1: bottom‑aligned headers ── */
  .footer-logo-area       { grid-area: logo;       align-self: end; }
  .footer-header-prod     { grid-area: header-prod; align-self: end; }
  .footer-header-comp     { grid-area: header-comp; align-self: end; }

  .footer-header-prod h4,
  .footer-header-comp h4 {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  /* ── Row 2: top‑aligned body content ── */
  .footer-brand-content   { grid-area: content;    align-self: start; }
  .footer-links-prod      { grid-area: links-prod; align-self: start; }
  .footer-links-comp      { grid-area: links-comp; align-self: start; }

  /* ── Logo text ── */
  .footer-logo-text-underlay {
    position: relative;
    display: flex;
    bottom: 0;
    z-index: -1;
    font-family: var(--font-z);
    font-size: var(--size-display);
    line-height: 1;
    font-weight: 500;
    text-align: center;
    width: min-content;
    @apply tracking-tight lowercase;
  }

  .footer-tagline {
    font-size: 0.82rem;
    color: var(--color-muted-foreground);
    line-height: 1.6;
    max-width: 260px;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links li {
    margin-bottom: 6px;
  }

  .footer-links a {
    color: var(--color-muted-foreground);
    text-decoration: none;
    font-size: 0.82rem;
    transition: color 0.2s;
    padding: 4px 2px;
  }

  .footer-links a:hover {
    color: var(--color-foreground);
  }

  .footer-copy {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-muted-foreground);
    letter-spacing: 0.08em;
  }

  /* ── Responsive: tablet ── */
  @media (max-width: 1024px) {
    .footer-main {
      gap: 20px 32px;
    }
  }

  /* ── Responsive: mobile ── */
  @media (max-width: 768px) {
    .footer-main {
      grid-template-areas:
        "logo"
        "content"
        "header-prod"
        "links-prod"
        "header-comp"
        "links-comp";
      grid-template-columns: 1fr;
      gap: 16px;
    }

    /* Reset align-self on mobile so items flow naturally */
    .footer-logo-area,
    .footer-brand-content,
    .footer-header-prod,
    .footer-links-prod,
    .footer-header-comp,
    .footer-links-comp {
      align-self: auto;
    }
  }
</style>
