  "license": "MIT",
  "scripts": {
    "dev": "node --import tsx scripts/dev-runner.ts src/server/index.ts",
    "worker": "node scripts/dev-runner.ts tsx --watch src/worker/index.ts",
    "pipeline": "node scripts/dev-runner.ts tsx --watch src/pipeline/index.ts",
    "workflow": "node scripts/dev-runner.ts src/pipeline/execute.ts",
    "watch": "npx tsc -b -w",
    "build": "tsx scripts/build.ts",
    "start": "NODE_ENV=production node --enable-source-maps dist/server/index.js",
    "start:worker": "NODE_ENV=production node --enable-source-maps dist/worker/index.js",
    "start:pipeline": "NODE_ENV=production node --enable-source-maps dist/pipeline/index.js",
    "start:workflow": "NODE_ENV=production node --enable-source-maps dist/pipeline/execute.js",
    "check": "npx tsc -b --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest run src/pipeline/tests/generative-workflow.integration.test.ts",
    "db:push": "npx tsx node_modules/drizzle-kit/bin.cjs push --config drizzle.config.ts",
    "website:dev": "cd website && node scripts/link-docs.js && next dev",
    "website:build": "cd website && node scripts/link-docs.js && next build",
    "website:start": "cd website && next start",
    "website:lint": "cd website && next lint",
    "test:pubsub": "tsx scripts/pubsub-testing/repl.ts"
  },
