[
  {
    "label": "Attach to Server",
    "adapter": "JavaScript",
    "type": "node",
    "request": "attach",
    "port": 9231,
    "restart": true,
    "skipFiles": ["<node_internals>/**"],
  },
  {
    "label": "Attach to Vitest",
    "adapter": "JavaScript",
    "type": "node",
    "request": "attach",
    "port": 9229,
    "restart": true,
    "skipFiles": ["<node_internals>/**"],
  },
  {
    "label": "Debug Current File",
    "adapter": "JavaScript",
    "request": "launch",
    "command": "node",
    "args": ["--import", "tsx", "$ZED_FILE", "$ZED_FILE"],
    "use_new_terminal": true,
  },
  {
    "label": "Debug Build (server)",
    "adapter": "JavaScript",
    "request": "launch",
    "command": "node",
    "args": ["dist/server/index.js"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
  },
  {
    "label": "Debug Build (worker)",
    "adapter": "JavaScript",
    "request": "launch",
    "command": "node",
    "args": ["dist/worker/index.js"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
  },
  {
    "label": "Debug Build (pipeline)",
    "adapter": "JavaScript",
    "request": "launch",
    "command": "node",
    "args": ["dist/pipeline/index.js"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
  },
  {
    "label": "Launch Workflow - Debug Existing Video",
    "adapter": "JavaScript",
    "request": "launch",
    "command": "node",
    "args": [
      "dist/pipeline/execute-workflow.js",
      "--id",
      "video_1765360860268",
    ],
    "use_new_terminal": true,
  },
]
